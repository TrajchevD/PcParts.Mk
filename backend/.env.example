# ── Database ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=pcbuilder

# ── JWT Authentication ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-GENERATE-WITH-SECRETS-TOKEN-HEX-32
JWT_EXPIRE_HOURS=24

# ── Admin API Key (protects /api/alerts/check) ────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_API_KEY=CHANGE-ME-GENERATE-WITH-SECRETS-TOKEN-HEX-16

# ── CORS Origins (comma-separated) ───────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────
# Set to "production" in production deployments
ENV=development
